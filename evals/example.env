# LiteLLM gateway the evals call (OpenAI-compatible). Use the host IP when running from another machine.
LITELLM_BASE_URL=http://localhost:4000
# Admin or virtual key of the gateway. CHANGE_ME: put your LITELLM_MASTER_KEY here.
LITELLM_API_KEY=sk-CHANGE_ME
# Model (as named in LiteLLM) that judges the DeepEval LLM metrics (GEval, Faithfulness, Answer Relevancy).
# It is also one of the evaluated chat models, so its own scores can be biased: see docs/MODEL_EVAL_REPORT.md.
JUDGE_MODEL=gemma4:12b
# Thinking level of the judge: none (fast, avoids empty answers) | low | medium | high
JUDGE_REASONING_EFFORT=none
# Keep DeepEval from sending usage data
DEEPEVAL_TELEMETRY_OPT_OUT=YES
