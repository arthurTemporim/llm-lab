# LiteLLM gateway the evals call (OpenAI-compatible). Use the host IP when running from another machine.
LITELLM_BASE_URL=http://localhost:4000
# Admin or virtual key of the gateway. `make configure` / `make init` create evals/.env and set it
# to LITELLM_MASTER_KEY from modules/litellm/.env.
LITELLM_API_KEY=sk-CHANGE_ME
# Decision model (as named in LiteLLM, served at /v1/systemone) that judges the chat answers with yes/no checks.
# It is not one of the evaluated chat models, so it cannot favour its own answers. See docs/MODEL_EVAL_REPORT.md.
JUDGE_MODEL=tev1:4b
# Thinking level of a chat-model judge (used only by the gemma4:12b baseline in judge_experiment.py): none | low | medium | high
JUDGE_REASONING_EFFORT=none
# Keep DeepEval from sending usage data
DEEPEVAL_TELEMETRY_OPT_OUT=YES
