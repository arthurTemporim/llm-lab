# Bind inside the container/docker network. Other modules reach it as http://ollama:11434
OLLAMA_HOST=0.0.0.0
# Host port
OLLAMA_PORT=11434

# Allowed CORS origins (e.g. Obsidian: app://obsidian.md*, mobile: capacitor://localhost)
OLLAMA_ORIGINS=*

# Keep the model loaded between calls (tune to your RAM/VRAM)
OLLAMA_KEEP_ALIVE=5m

# Multi-GPU: spread each model across all GPUs instead of loading it on one GPU when it fits.
# Keep it off (default) with mixed cards: on RTX 3060 + Tesla P4, gemma4:12b generated 4000 tokens
# at 22 tok/s spread over both cards and 44 tok/s on one card (the slower P4 sets the pace).
# Use it only for models too big for one card.
# OLLAMA_SCHED_SPREAD=1

# Optional performance tuning (uncomment and adjust to your hardware/models)
# Requests handled at the same time by each loaded model. Context memory (KV cache)
# grows with this value, so keep 1 when VRAM is tight.
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_NUM_THREADS=0        # 0 = auto
# Flash Attention: lowers memory use of long contexts. Required by OLLAMA_KV_CACHE_TYPE.
# OLLAMA_FLASH_ATTENTION=1    # only if your build supports it; test first
# Quantizes the KV cache (needs OLLAMA_FLASH_ATTENTION=1). f16 = default, q8_0 = about
# half the memory with minimal quality loss, q4_0 = about a quarter with more quality loss.
# OLLAMA_KV_CACHE_TYPE=q8_0
# Max models kept loaded at once (default: 3 per GPU). When the limit is reached, a request
# for another model waits until the least recently used idle model unloads (reload costs
# seconds). Lower it to avoid models being split between GPU and CPU.
# OLLAMA_MAX_LOADED_MODELS=2

# NVIDIA (ignored on CPU-only hosts)
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
