# Host port of the manager (the docling container). Other modules reach it as http://docling:5001.
# docling-serve itself runs in docling-worker, started and stopped on demand by the manager.
DOCLING_PORT=5001

# --- Manager ---
# Seconds without work before the manager stops docling-worker to free RAM/VRAM. The next
# request pays a cold start (models load again).
DOCLING_MANAGER_IDLE_TIMEOUT=30
# Seconds to wait for docling-worker to become healthy after a start
DOCLING_MANAGER_START_TIMEOUT=300
# Seconds one conversion attempt may run before it counts as stuck (worker restarted, job retried)
DOCLING_MANAGER_TASK_TIMEOUT=1800
# Retries per job after a failure. Each failure restarts docling-worker first.
DOCLING_MANAGER_MAX_RETRIES=2
# Jobs sent to docling-worker at once; the rest queue in the manager. Keep it equal to
# DOCLING_SERVE_ENG_LOC_NUM_WORKERS.
DOCLING_MANAGER_CONCURRENCY=2
# Seconds the sync endpoints (/v1/convert/file, /v1/convert/source) wait, cold start and retries
# included. Use the async endpoints for long documents.
DOCLING_MANAGER_SYNC_WAIT=1800
# Seconds a finished result is kept when nobody fetches it
DOCLING_MANAGER_RESULT_TTL=3600
# DEBUG, INFO, WARNING or ERROR
DOCLING_MANAGER_LOG_LEVEL=INFO

# --- docling-serve (docling-worker) ---

# Web UI at /ui (/ redirects there)
DOCLING_SERVE_ENABLE_UI=true

# Conversions processed at the same time. This is the one setting that caps Docling load for
# every client: extra requests wait in the queue. Each worker loads its own models, so RAM/VRAM
# grows with it unless DOCLING_SERVE_ENG_LOC_SHARE_MODELS=true.
DOCLING_SERVE_ENG_LOC_NUM_WORKERS=2
# DOCLING_SERVE_ENG_LOC_SHARE_MODELS=true

# Seconds docling-serve's own sync endpoint waits. The manager always uses the async endpoints,
# so clients are bound by DOCLING_MANAGER_SYNC_WAIT instead.
DOCLING_SERVE_MAX_SYNC_WAIT=120

# Optional per-document limits (unset = no limit)
# DOCLING_SERVE_MAX_NUM_PAGES=200
# DOCLING_SERVE_MAX_FILE_SIZE=104857600

# Device for the layout, table and OCR models: cpu, cuda or cuda:<n>. Unset = auto
# (cuda with the GPU override, cpu otherwise).
# DOCLING_DEVICE=cuda
# Torch threads on CPU (default 4)
# DOCLING_NUM_THREADS=4

# API key. Unset = no auth. When set, clients send it in the X-Api-Key header; the manager checks
# it and forwards it to docling-worker. Do not leave it set to an empty value: docling-serve reads
# that as None and fails to start.
# DOCLING_SERVE_API_KEY=CHANGE_ME

# WARNING, INFO or DEBUG
DOCLING_SERVE_LOG_LEVEL=WARNING

# GPU index Docling may use, as listed by `nvidia-smi -L`. The CUDA 12.8 image does not run on
# Pascal cards (Tesla P4, GTX 10xx): point this at the RTX 3060 / Turing or newer card.
DOCLING_GPU_ID=0

# NVIDIA runtime (ignored on CPU-only hosts)
NVIDIA_DRIVER_CAPABILITIES=compute,utility
