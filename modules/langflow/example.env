# Host port
LANGFLOW_PORT=7860

LANGFLOW_LOG_LEVEL=debug
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_SUPERUSER=lang
# Generated by `make create-envs`
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_ME_PASSWORD
# POSTGRES_URL comes from the global modules/common-services/.env
LANGFLOW_DATABASE_URL=${POSTGRES_URL}/langflow
LANGFLOW_NEW_USER_IS_ACTIVE=false
#LANGFLOW_SSRF_ALLOWED_HOSTS=0.0.0.0
