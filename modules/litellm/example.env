# Host ports (gateway / Prometheus)
LITELLM_PORT=4000
LITELLM_PROMETHEUS_PORT=9090

# ${VAR} values come from the global modules/common-services/.env.
# Database "litellm" is created by `make databases` (part of `make common-services`)
DATABASE_URL=${POSTGRES_URL}/litellm
# Models come from the generated config.yaml (see models.yaml). True also loads the
# models added in the UI, which duplicates any that exist in both places.
STORE_MODEL_IN_DB=False

# Used by litellm-init to discover models, and as api_base of the generated entries
OLLAMA_API_BASE=${OLLAMA_URL}
# How long litellm-init waits for Ollama before keeping the last generated config
OLLAMA_WAIT_SECONDS=60
# CHANGE_ME* is replaced by a random value in `make create-envs`. Keys must start with "sk-".
# Never change the salt key after first use (it encrypts stored provider keys).
LITELLM_MASTER_KEY=sk-CHANGE_ME
LITELLM_SALT_KEY=sk-CHANGE_ME
UI_USERNAME=litellm
UI_PASSWORD=CHANGE_ME_PASSWORD

# Langfuse project keys, read by LiteLLM when the langfuse callback is enabled in config.yaml
LANGFUSE_PUBLIC_KEY=${LANGFUSE_PUBLIC_KEY}
LANGFUSE_SECRET_KEY=${LANGFUSE_SECRET_KEY}
LANGFUSE_HOST=${LANGFUSE_HOST}
