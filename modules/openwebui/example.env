# Host port
OPENWEBUI_PORT=3000

#WEBUI_URL=
#WEBUI_NAME=
#DEFAULT_PROMPT_SUGGESTIONS=
#CORS_ALLOW_ORIGIN='*'
# Admin account created on the first start (no users yet); Open WebUI then turns sign-up off.
# LAB_EMAIL / LAB_USER come from the global modules/common-services/.env.
WEBUI_ADMIN_EMAIL=${LAB_EMAIL}
WEBUI_ADMIN_NAME=${LAB_USER}
WEBUI_ADMIN_PASSWORD=CHANGE_ME_PASSWORD
ENABLE_SIGNUP=true
ENABLE_SIGNUP_PASSWORD_CONFIRMATION=false
ENABLE_LOGIN_FORM=true
RESPONSE_WATERMARK="This text is AI generated"
MODELS_CACHE_TTL=10
#USE_CUDA_DOCKER=true
AIOHTTP_CLIENT_TIMEOUT_MODEL_LIST=30
DATA_DIR=./data
ENABLE_OLLAMA_API=true
# OLLAMA_URL comes from the global modules/common-services/.env
OLLAMA_BASE_URL=${OLLAMA_URL}
ENABLE_OPENAI_API=true
ENABLE_CODE_EXECUTION=true
OFFLINE_MODE=true
RAG_EMBEDDING_MODEL_TRUST_REMOTE_CODE=false
ENABLE_WEB_SEARCH=true
ENABLE_IMAGE_GENERATION=true
#IMAGE_GENERATION_MODEL=
