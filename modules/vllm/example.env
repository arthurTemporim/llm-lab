# Hugging Face repo to serve (one model per vLLM process). Candidates and sizes: docs/HUGGINGFACE_MODELS.md
# Default: uncensored Dolphin 3.0 (Llama 3.1 8B), fits a 12 GB card with the fp8 option below.
VLLM_MODEL=dphn/Dolphin3.0-Llama3.1-8B

# Context window in tokens. Lower it when you run out of VRAM (KV cache grows with it).
VLLM_MAX_MODEL_LEN=8192

# Share of the GPU's VRAM vLLM may take (0.1 - 1.0). It reserves it up front, so lower it
# if Ollama or another process uses the same card.
VLLM_GPU_MEMORY_UTILIZATION=0.90

# Extra `vllm serve` flags, passed as is. Pick what the model needs:
#   --quantization fp8            quantize bf16 weights while loading (about 1 byte/param), 8-9B on 12 GB
#   --quantization bitsandbytes   4-bit on load (about 0.55 byte/param), 12-14B on 12 GB, slower
#   --runner pooling              serve an embedding model (/v1/embeddings)
#   --served-model-name <name>    name clients send instead of the Hugging Face id
#   --enable-auto-tool-choice --tool-call-parser <parser>   tool calling (parser depends on the model)
VLLM_EXTRA_ARGS=--quantization fp8

# API key clients must send (`Authorization: Bearer ...`). vLLM reads this variable itself.
# CHANGE_ME is replaced by a random value in `make create-envs`.
VLLM_API_KEY=sk-CHANGE_ME

# Hugging Face token. Only needed for gated or private repos (accept the license on the model page first).
HF_TOKEN=

# GPU index vLLM may use, as listed by `nvidia-smi -L`. vLLM does not run on Pascal cards
# (Tesla P4, GTX 10xx): point this at the RTX 3060 / Turing or newer card.
VLLM_GPU_ID=0

# Host port. Do not call it VLLM_PORT: vLLM reads that name for its own internal port.
VLLM_HOST_PORT=8000

# NVIDIA runtime
NVIDIA_DRIVER_CAPABILITIES=compute,utility
