# Postgres (pgvector). Connection strings in other modules must use the same user/password.
POSTGRES_USER=lang
POSTGRES_PASSWORD=lang
# Databases created by `make databases`, space separated (each gets the vector extension)
POSTGRES_DATABASES=langflow langfuse litellm

# MinIO (S3-compatible object storage). Must match modules/langfuse/.env (`make check-env`).
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
# Space separated list of buckets created at startup
MINIO_BUCKETS=langfuse

# Host ports. 5432 postgres, 6380 redis (6379 is commonly taken), 9100/9101 minio
# (9090 is avoided because Prometheus in litellm uses it).
POSTGRES_PORT=5432
REDIS_PORT=6380
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
