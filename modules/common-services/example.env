# Global values, shared by every module. The Makefile loads this file before each module's own
# .env, so modules reference these values as ${VAR} instead of copying them. Set them here only:
# a module .env that redefines one with another value fails `make check-env`.
# CHANGE_ME* placeholders are filled by `make create-envs` (scripts/generate_secrets.sh).

# --- Host -------------------------------------------------------------------
# Host name or IP that browsers and clients outside Docker use to reach this machine. Set it to
# the LAN IP (for example 192.168.15.102) to use the lab from another machine.
LAB_PUBLIC_HOST=localhost

# Host ports: 5432 postgres, 6380 redis (6379 is commonly taken), 9100 garage S3 API (9000 is
# avoided because ClickHouse in langfuse uses it).
POSTGRES_PORT=5432
REDIS_PORT=6380
GARAGE_S3_PORT=9100

# --- Postgres (pgvector) ----------------------------------------------------
# User and password apply only when the postgres volume is first created.
POSTGRES_USER=lang
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_HOST=postgres
# Base connection string; modules append /<database>. Keep the password URL-safe (generated ones are).
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432
# Databases created by `make databases`, space separated (each gets the vector extension)
POSTGRES_DATABASES=langflow langfuse litellm hatchet

# --- Redis (no password) ----------------------------------------------------
REDIS_HOST=redis
REDIS_URL=redis://${REDIS_HOST}:6379

# --- Garage (S3-compatible object storage) ----------------------------------
# The key and bucket are created at startup if missing. Key is "GK" + 24 hex chars, secret is
# 64 hex chars.
GARAGE_DEFAULT_ACCESS_KEY=GKCHANGE_ME_HEX24
GARAGE_DEFAULT_SECRET_KEY=CHANGE_ME
GARAGE_DEFAULT_BUCKET=langfuse
# Internal RPC secret (64 hex chars)
GARAGE_RPC_SECRET=CHANGE_ME
# Endpoint inside the lang network, and the one browsers use (GARAGE_S3_PORT below)
GARAGE_S3_ENDPOINT=http://garage:3900
GARAGE_S3_EXTERNAL_ENDPOINT=http://${LAB_PUBLIC_HOST}:${GARAGE_S3_PORT}
# Must be s3_region in modules/common-services/garage.toml
GARAGE_S3_REGION=garage

# --- Services used by several modules (lang network addresses) --------------
OLLAMA_URL=http://ollama:11434

# --- Langfuse project API keys ----------------------------------------------
# Seeded into the Langfuse project on its first start; clients (LiteLLM, notebooks) use them.
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME
LANGFUSE_HOST=http://langfuse-web:3000
