# MinIO (S3-compatible object storage) shared by the modules
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
# Space separated list of buckets created at startup
MINIO_BUCKETS=langfuse
# Host ports (API / console). 9090 is avoided because LiteLLM's Prometheus uses it.
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
