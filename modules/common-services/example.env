# Postgres (pgvector). Connection strings in other modules must use the same user/password.
POSTGRES_USER=lang
POSTGRES_PASSWORD=lang
# Databases created by `make databases`, space separated (each gets the vector extension)
POSTGRES_DATABASES=langflow langfuse litellm hatchet

# Garage (S3-compatible object storage). The key and bucket are created at startup if missing.
# Key and secret must match modules/langfuse/.env (`make check-env`).
# Key is "GK" + 24 hex chars, secret is 64 hex chars (local development defaults).
GARAGE_DEFAULT_ACCESS_KEY=GK11223344556677889900aabb
GARAGE_DEFAULT_SECRET_KEY=6c6c6d2d6c61622d6c6f63616c2d64656661756c742d7365637265742d303031
GARAGE_DEFAULT_BUCKET=langfuse
# Internal RPC secret (64 hex chars)
GARAGE_RPC_SECRET=CHANGE_ME

# Host ports. 5432 postgres, 6380 redis (6379 is commonly taken), 9100 garage S3 API
# (9000 is avoided because ClickHouse in langfuse uses it).
POSTGRES_PORT=5432
REDIS_PORT=6380
GARAGE_S3_PORT=9100
