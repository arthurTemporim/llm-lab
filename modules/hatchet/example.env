# Host ports. Other modules reach it as http://hatchet-lite:8888 and hatchet-lite:7077
# (8888 is taken by notebooks)
HATCHET_PORT=8889
HATCHET_GRPC_PORT=7077

# Host name or IP that browsers and workers outside Docker use to reach this machine. It sets
# SERVER_URL, the cookie domain and the gRPC address handed to workers. Use the server's LAN IP
# (for example 192.168.15.102) when the dashboard or workers run on another machine.
# Defaults to LAB_PUBLIC_HOST from the global modules/common-services/.env.
HATCHET_PUBLIC_HOST=${LAB_PUBLIC_HOST}

# --- Postgres (shared, from common-services) -------------------------------
# Database "hatchet" is created by `make databases`. POSTGRES_URL comes from common-services.
# sslmode=disable: Hatchet tries TLS by default and the shared Postgres has none.
DATABASE_URL=${POSTGRES_URL}/hatchet?sslmode=disable
# Connection pool cap (Hatchet default 50). Lower values starve Hatchet's own components
# (heartbeat statement timeouts). The shared Postgres allows 200 connections in total.
DATABASE_MAX_CONNS=50

# --- Server ----------------------------------------------------------------
# Plain HTTP and gRPC without TLS: fine on a LAN, not on the internet
SERVER_AUTH_COOKIE_INSECURE=t
SERVER_GRPC_INSECURE=t
SERVER_GRPC_BIND_ADDRESS=0.0.0.0
# Container gRPC port (the host side is HATCHET_GRPC_PORT)
SERVER_GRPC_PORT=7077
# Skip email verification for new users (there is no mail server)
SERVER_AUTH_SET_EMAIL_VERIFIED=t

# --- Admin user, created on the first start only ---------------------------
# LAB_EMAIL / LAB_USER come from the global modules/common-services/.env. The password is
# generated by `make create-envs`; change it in the dashboard afterwards
ADMIN_EMAIL=${LAB_EMAIL}
ADMIN_NAME=${LAB_USER}
ADMIN_PASSWORD=CHANGE_ME_PASSWORD
