# ---------------------------------------------------------------------------
# Langfuse module - copy to .env (make create-envs does it for you)
# CHANGE_ME* placeholders are replaced by random values in `make create-envs`.
# ${VAR} values come from the global modules/common-services/.env.
# ---------------------------------------------------------------------------

# Image tag used for langfuse (web) and langfuse-worker
LANGFUSE_VERSION=4.71

# Host port of the web UI / API
LANGFUSE_PORT=3001
# Admin-only worker port (bound to 127.0.0.1)
LANGFUSE_WORKER_PORT=3030
# Public URL used for auth callbacks (must match the real URL the browser opens)
# NEXTAUTH_URL defaults to http://$LAB_PUBLIC_HOST:$LANGFUSE_PORT; set it when behind a proxy
#NEXTAUTH_URL=http://localhost:3001

# --- Secrets (never change ENCRYPTION_KEY and SALT after first use) --------
NEXTAUTH_SECRET=CHANGE_ME
SALT=CHANGE_ME
# Must be exactly 64 hex chars (256 bit)
ENCRYPTION_KEY=CHANGE_ME

TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
# Disable the public sign-up page once your user exists
AUTH_DISABLE_SIGNUP=false

# --- Postgres (shared, from common-services) -------------------------------
# Database "langfuse" is created by `make databases`
DATABASE_URL=${POSTGRES_URL}/langfuse

# Redis (shared, no password): REDIS_HOST from common-services, set in docker-compose.yml

# --- ClickHouse (this module) ----------------------------------------------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME_PASSWORD
CLICKHOUSE_URL=http://langfuse-clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://langfuse-clickhouse:9000

# --- Garage / S3 (shared, from common-services) ----------------------------
# The key and secret are GARAGE_DEFAULT_* from common-services, read by docker-compose.yml
LANGFUSE_S3_BUCKET=${GARAGE_DEFAULT_BUCKET}
LANGFUSE_S3_REGION=${GARAGE_S3_REGION}
# Container-to-container endpoint
LANGFUSE_S3_ENDPOINT=${GARAGE_S3_ENDPOINT}
# Endpoint reachable from your browser
LANGFUSE_S3_EXTERNAL_ENDPOINT=${GARAGE_S3_EXTERNAL_ENDPOINT}
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false

# --- Headless init: org, project, keys and admin user ----------------------
# Applied on first start only. Leave empty to sign up manually in the UI.
LANGFUSE_INIT_ORG_ID=llm-lab
LANGFUSE_INIT_ORG_NAME=llm-lab
LANGFUSE_INIT_PROJECT_ID=llm-lab
LANGFUSE_INIT_PROJECT_NAME=llm-lab
# Project API keys: LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY from common-services, so clients
# configured from the same file match
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=${LANGFUSE_PUBLIC_KEY}
LANGFUSE_INIT_PROJECT_SECRET_KEY=${LANGFUSE_SECRET_KEY}
# Admin user: LAB_EMAIL / LAB_USER from common-services
LANGFUSE_INIT_USER_EMAIL=${LAB_EMAIL}
LANGFUSE_INIT_USER_NAME=${LAB_USER}
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME_PASSWORD
