# ---------------------------------------------------------------------------
# Langfuse module - copy to .env (make create-envs does it for you)
# CHANGE_ME is replaced by a random value in `make create-envs`
# ---------------------------------------------------------------------------

# Image tag used for langfuse (web) and langfuse-worker
LANGFUSE_VERSION=4.54

# Host port of the web UI / API
LANGFUSE_PORT=3001
# Admin-only worker port (bound to 127.0.0.1)
LANGFUSE_WORKER_PORT=3030
# Public URL used for auth callbacks (must match the real URL the browser opens)
# NEXTAUTH_URL defaults to http://localhost:$LANGFUSE_PORT; set it when behind a proxy
#NEXTAUTH_URL=http://localhost:3001

# --- Secrets (never change ENCRYPTION_KEY and SALT after first use) --------
NEXTAUTH_SECRET=CHANGE_ME
SALT=CHANGE_ME
# Must be exactly 64 hex chars (256 bit)
ENCRYPTION_KEY=CHANGE_ME

TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
# Disable the public sign-up page once your user exists
AUTH_DISABLE_SIGNUP=false

# --- Postgres (shared, from common-services) -------------------------------
# Database "langfuse" is created by `make databases`
DATABASE_URL=postgresql://lang:lang@postgres:5432/langfuse

# --- Redis (shared, from common-services; no password) ---------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- ClickHouse (this module) ----------------------------------------------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000

# --- MinIO / S3 (shared, from common-services) -----------------------------
# Must match modules/common-services/.env (checked by `make check-env`)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_REGION=auto
# Container-to-container endpoint
LANGFUSE_S3_ENDPOINT=http://minio:9000
# Endpoint reachable from your browser (MINIO_API_PORT in common-services)
LANGFUSE_S3_EXTERNAL_ENDPOINT=http://localhost:9100
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false

# --- Headless init: org, project, keys and admin user ----------------------
# Applied on first start only. Leave empty to sign up manually in the UI.
LANGFUSE_INIT_ORG_ID=llm-lab
LANGFUSE_INIT_ORG_NAME=llm-lab
LANGFUSE_INIT_PROJECT_ID=llm-lab
LANGFUSE_INIT_PROJECT_NAME=llm-lab
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-llm-lab-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-llm-lab-local
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=change-me-admin
